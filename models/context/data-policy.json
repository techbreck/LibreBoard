  "maximumSentenceTokens": 64,
  "minimumSentenceTokens": 2,
  "maximumAuthoredExpansionsPerTemplate": 25000,
  "minimumAcceptedSentences": 50000,
  "minimumGermanSentences": 10000,
  "maximumRejectedFraction": 0.25
}
