{
  "schemaVersion": 1,
  "sourceId": "futo-swipe-dataset-v1",
  "dataArtifacts": [
    "train.jsonl",
    "dev.jsonl",
    "test.jsonl"
  ],
  "projectAuthoredData": "models/context/project-authored-de-v1.json",
  "splitSalt": "libreboard-context-session-split-v1",
  "splitBasisPoints": {
    "train": 9000,
    "validation": 500,
