  "templates": [
    {
      "id": "third-person-actions",
      "fieldClass": "plain",
      "text": "{actor} {singular_action} {object_accusative} {time}.",
      "slots": ["actor", "singular_action", "object_accusative", "time"],
      "sessionBuckets": 128
    },
    {
      "id": "shared-actions",
      "fieldClass": "plain",
      "text": "Wir {plural_action} {object_accusative} {time}.",
      "slots": ["plural_action", "object_accusative", "time"],
      "sessionBuckets": 64
    },
    {
      "id": "questions",
      "fieldClass": "short_message",
      "text": "Kannst du {object_accusative} {time} {infinitive_action}?",
      "slots": ["object_accusative", "time", "infinitive_action"],
      "sessionBuckets": 64
    },
    {
      "id": "requests",
      "fieldClass": "short_message",
      "text": "Bitte {object_accusative} {time} {infinitive_action}.",
      "slots": ["object_accusative", "time", "infinitive_action"],
      "sessionBuckets": 64
    },
    {
      "id": "future-actions",
      "fieldClass": "plain",
      "text": "{actor} wird {object_accusative} {time} {infinitive_action}.",
      "slots": ["actor", "object_accusative", "time", "infinitive_action"],
      "sessionBuckets": 128
    },
    {
      "id": "modal-actions",
      "fieldClass": "plain",
      "text": "{actor} kann {object_accusative} {time} {infinitive_action}.",
      "slots": ["actor", "object_accusative", "time", "infinitive_action"],
      "sessionBuckets": 128
    },
    {
      "id": "neuter-properties",
      "fieldClass": "plain",
      "text": "Das {neuter_system} ist {adjective}.",
      "slots": ["neuter_system", "adjective"],
      "sessionBuckets": 32
    },
    {
      "id": "feminine-properties",
      "fieldClass": "plain",
      "text": "Die {feminine_system} ist {adjective}.",
      "slots": ["feminine_system", "adjective"],
      "sessionBuckets": 32
    },
    {
      "id": "subordinate-properties",
      "fieldClass": "plain",
      "text": "Ich glaube, dass das {neuter_system} {adjective} ist.",
      "slots": ["neuter_system", "adjective"],
      "sessionBuckets": 32
    },
    {
      "id": "fallback-conditions",
      "fieldClass": "plain",
      "text": "Wenn {condition}, dann {result}.",
      "slots": ["condition", "result"],
      "sessionBuckets": 32
    },
    {
      "id": "privacy-protection",
      "fieldClass": "plain",
      "text": "Wir schützen {data} durch {protection}.",
      "slots": ["data", "protection"],
      "sessionBuckets": 32
    },
    {
      "id": "compound-coverage",
      "fieldClass": "plain",
      "text": "{compound_sentence}",
      "slots": ["compound_sentence"],
      "sessionBuckets": 16
    },
    {
      "id": "search-queries",
      "fieldClass": "search",
      "text": "Suche nach {search_target}",
      "slots": ["search_target"],
      "sessionBuckets": 16
    },
    {
      "id": "message-coverage",
      "fieldClass": "short_message",
      "text": "{short_message}",
      "slots": ["short_message"],
      "sessionBuckets": 16
    },
    {
      "id": "confusion-coverage",
      "fieldClass": "plain",
      "text": "{confusion_sentence}",
      "slots": ["confusion_sentence"],
      "sessionBuckets": 16
    }
